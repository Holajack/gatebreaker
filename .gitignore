.DS_Store

# Local-only working files kept outside version control
_stray-site-files-backup/
Ultimate RPG Items Pack - Aug 2019/

# Downloaded CC0 source art: ~190 MB of FBX/glTF/zip build INPUT across
# characters (65 MB), creatures (96 MB) and world (31 MB). Nothing at runtime
# reads from here — tools/build-*-glb.mjs consume it and emit public/models/.
# The provenance and licence files stay tracked so the packs can be re-fetched
# and the CC0 attribution survives without the art.
assets/source/**
# Directories at EVERY depth must be re-included or git never descends far
# enough to see the whitelisted files below — `!assets/source/*/` alone
# silently swallowed every License.txt more than two levels deep (KayKit packs
# nest theirs 4-5 deep). Only the trailing-slash dir pattern is un-ignored;
# files still fall to `assets/source/**` unless a whitelist below names them.
!assets/source/**/
!assets/source/**/PROVENANCE.md
!assets/source/**/CREDITS.md
!assets/source/**/LICENSE*
!assets/source/**/License*
# The Easy Enemy EVALUATE-gate verdict (all 6 skipped) is a decision record,
# not art: it must survive the art being pruned, same as PROVENANCE.md.
!assets/source/**/EVALUATION.json

# Android build output
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
*.apk
*.aab
*.keystore

# The CONVERTED item pack, however, MUST ship. The source above is gitignored
# and exists on exactly one Mac, so CI can never regenerate these. A rule that
# swallowed them would produce a build with zero models and no error at all —
# which is the specific failure tools/items-verify.mjs exists to catch.
!public/models/
!public/models/items.glb
!public/models/icons.webp
!public/models/icons.json
!public/models/characters.glb
!public/models/characters.json
!public/models/creatures.glb
!public/models/creatures.json
!public/models/citykit.glb
!public/models/citykit.json
!public/models/nature.glb
!public/models/nature.json
.handoffs/
