    "test:items": "node tools/items-verify.mjs",
    "test:characters": "node tools/character-test.mjs",
    "test:creatures": "node tools/build-creatures-glb.mjs --verify",
    "test:world": "node tools/build-world-glb.mjs --verify",
    "test:nav": "node tools/nav-test.mjs",
    "test:loot": "node tools/loot-test.mjs",
    "test:loot-fallback": "node tools/loot-test.mjs --no-models",
    "test:city": "node tools/city-test.mjs",
    "test:frontier": "node tools/frontier-test.mjs",
    "test:daynight": "node tools/daynight-test.mjs",
    "test:interiors": "node tools/interior-test.mjs",
    "test:citylife": "node tools/citylife-test.mjs",
    "test:shop": "node tools/shop-test.mjs",
    "test:progression": "node tools/progression-test.mjs",
    "test:classes": "node tools/classes-test.mjs",
    "test:frameclock": "node tools/frameclock-test.mjs",
    "test:entities": "node tools/entity-test.mjs",
    "test:fight": "node tools/fight-test.mjs",
    "test:weapons": "node tools/weapon-feel-test.mjs",
    "test:flow": "node tools/flow-test.mjs",
    "test:inventory": "node tools/inventory-test.mjs",
    "test:armor": "node tools/armor-test.mjs",
    "test:ascension": "node tools/ascension-test.mjs",
    "test:acceptance": "node tools/acceptance.mjs",
    "test:collision": "node tools/collision-test.mjs",
    "test:dungeon-gen": "node tools/dungeon-gen-test.mjs",
    "test:dungeon": "node tools/dungeon-test.mjs",
    "test:visual": "node tools/visual-test.mjs",
    "test:creatures-live": "node tools/creature-test.mjs"
