  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "gltfpack": "^0.22.0",
    "meshoptimizer": "^1.2.0",
    "playwright": "^1.49.1",
    "sharp": "^0.35.3",
    "vite": "^5.4.11"
